<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <RootNamespace>SatTrack.App</RootNamespace>
    <AssemblyName>GS232B-Interface</AssemblyName>
    <Product>GS-232B Interface Software</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SatTrack.Core\SatTrack.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\world.txt" LogicalName="SatTrack.App.world.txt" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="SatTrack.App.app.ico" />
  </ItemGroup>

</Project>
